{
  "name": "studylock",
  "version": "1.1.0",
  "productName": "StudyLock",
  "description": "Distraction-Free Immersion Study & Desk Clock App",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable nsis"
  },
  "keywords": [
    "study",
    "focus",
    "desk-clock",
    "immersion",
    "youtube-player",
    "jee",
    "neet"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "build": {
    "appId": "com.studylock.app",
    "productName": "StudyLock",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "src/assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "StudyLock",
      "artifactName": "StudyLock-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "StudyLock-Portable-${version}.${ext}",
      "requestExecutionLevel": "user"
    }
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2"
  }
}
